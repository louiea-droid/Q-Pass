# Copy to .env.local (on your computer) or add in Netlify (live site). See README.

# Random text, 32+ characters. Signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Passcodes staff type to sign in. Pick ones that are hard to guess (not 1234).
SCANNER_PASSCODE=
ADMIN_PASSCODE=

# From the Sheet's Apps Script: Deploy > Manage deployments > Web app URL (ends in /exec)
APPS_SCRIPT_URL=
# Same value you put in the script's SECRET property (Project Settings > Script properties)
APPS_SCRIPT_SECRET=

# Supabase (recommended: fast). When SUPABASE_URL is set the app uses Supabase; leave it empty to use the Google Sheet.
# Supabase dashboard > Project Settings > API: "Project URL" and the "service_role" secret key. Never share the service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
