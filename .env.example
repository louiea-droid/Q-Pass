# Copy to .env.local (local) or set in Netlify (live). See README for how to get each value.

# Random string: run `npx auth secret` or any 32+ char random text
AUTH_SECRET=

# Google OAuth client (Google Cloud > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Service account (from its JSON key file: client_email and private_key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The long ID in the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
